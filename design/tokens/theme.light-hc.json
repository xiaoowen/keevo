        "$type": "color",
        "$value": "{color.red.800}"
      }
    },
    "warning": {
      "fg": {
        "$type": "color",
        "$value": "{color.amber.800}"
      }
    },
    "success": {
      "fg": {
        "$type": "color",
        "$value": "{color.green.700}"
      }
    },
    "info": {
      "fg": {
        "$type": "color",
        "$value": "{color.blue.700}"
      }
    }
  },
  "secret": {
    "digit": {
      "$type": "color",
      "$value": "{color.blue.800}"
    },
    "symbol": {
      "$type": "color",
      "$value": "{color.red.800}"
    }
  }
