{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "0.0.1",
  "description": "__MSG_description__",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "offscreen"
  ],
  "optional_permissions": [
    "clipboardRead",
    "clipboardWrite"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Keevo"
  },
  "commands": {
    "open-inline-menu": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "__MSG_openInlineMenu__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "menu.html",
        "bar.html"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
