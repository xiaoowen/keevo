{
  "manifest_version": 3,
  "name": "Keevo（开发版）",
  "version": "0.0.1",
  "description": "Keevo 浏览器扩展 M0 原型，只用于开发，请勿存放真实数据。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "activeTab", "scripting", "alarms", "offscreen"],
  "optional_permissions": ["clipboardRead", "clipboardWrite"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Keevo" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
